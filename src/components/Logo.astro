---
<svg class="mark" width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
  <circle cx="17" cy="17" r="16" fill="var(--c-surface-2)" />
  <circle cx="17" cy="15" r="6.5" fill="var(--c-accent)" />
  <path d="M5 21.5c2.4 0 2.4-1.6 4.8-1.6s2.4 1.6 4.8 1.6 2.4-1.6 4.8-1.6 2.4 1.6 4.8 1.6 2.4-1.6 4.8-1.6" fill="none" stroke="var(--c-sea)" stroke-width="1.8" stroke-linecap="round" />
  <path d="M7 26c2.2 0 2.2-1.4 4.4-1.4s2.2 1.4 4.4 1.4 2.2-1.4 4.4-1.4 2.2 1.4 4.4 1.4" fill="none" stroke="var(--c-sea)" stroke-width="1.8" stroke-linecap="round" opacity=".55" />
