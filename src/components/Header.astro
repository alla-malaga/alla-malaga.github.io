---
import { site } from '../config/site';
import { localePath, type Dictionary } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Logo from './Logo.astro';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const links = [
  { href: '#food', label: t.nav.food },
  { href: '#cleaning', label: t.nav.cleaning },
  { href: '#about', label: t.nav.about },
  { href: '#areas', label: t.nav.areas },
  { href: '#faq', label: t.nav.faq },
];
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(t.locale)} lang="es">
      <Logo />
      <span>{site.brand}</span>
    </a>
    <nav class="sections" aria-label={t.nav.primaryLabel}>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <LanguageSwitcher current={t.locale} label={t.nav.languageLabel} />
      <div class="wa"><WhatsAppButton t={t} variant="compact" /></div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(251 247 241 / 0.92);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: var(--header-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--c-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .sections {
    display: none;
  }
  .sections ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
  }
  .sections a {
    color: var(--c-ink-muted);
    font-size: var(--step--1);
    font-weight: 500;
    text-decoration: none;
  }
  .sections a:hover {
    color: var(--c-accent);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .wa {
    display: none;
  }
  @media (min-width: 48rem) {
    .wa {
      display: block;
    }
  }
  @media (min-width: 64rem) {
    .sections {
      display: block;
    }
  }
  @media (max-width: 24rem) {
    .bar {
      gap: var(--space-2);
    }
    .brand span {
      font-size: 1rem;
    }
  }
</style>
