---
/**
 * Spam-resistant email link. The address never appears in the HTML:
 * it is stored reversed + base64 in data-e and assembled by EmailScript.astro.
 * Without JavaScript, `showAddress` links fall back to "name [at] domain".
 */
import { site, contactEmail } from '../config/site';

interface Props {
  subject?: string;
  /** Render the address itself as the link text. */
  showAddress?: boolean;
  class?: string;
}
const { subject, showAddress = false, class: className } = Astro.props;
const encoded = site.emailEncoded;
const [user, domain] = contactEmail.split('@');
---
<a
  class:list={['email-link', className]}
  href="#contact"
  data-e={encoded}
  data-s={subject ? encodeURIComponent(subject) : undefined}
  data-show={showAddress ? '' : undefined}
>
  {showAddress ? <span class="email-fallback">{user} [at] {domain}</span> : <slot />}
</a>
