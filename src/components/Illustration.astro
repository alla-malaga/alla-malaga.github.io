---
/**
 * Flat, hand-drawn-feeling illustrations in the site palette.
 * Decorative only: always aria-hidden.
 */
interface Props {
  name: 'hero' | 'food' | 'home';
  class?: string;
}
const { name, class: className } = Astro.props;
---
{
  name === 'hero' && (
    <svg class={className} viewBox="0 0 420 460" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="ill-hero-arch">
          <path d="M80 460V206a130 130 0 0 1 260 0v254Z" />
        </clipPath>
      </defs>
      <path d="M40 460V196a170 170 0 0 1 340 0v264Z" fill="var(--c-surface-2)" />
      <g clip-path="url(#ill-hero-arch)">
        <rect x="80" y="70" width="260" height="400" fill="#f8e8d6" />
        <circle cx="252" cy="236" r="44" fill="var(--c-sun)" />
        <path d="M80 300c40-22 78-26 116-12 18 7 30 12 44 12H80Z" fill="var(--c-olive)" opacity=".55" />
        <rect x="80" y="298" width="260" height="90" fill="var(--c-sea)" />
        <g fill="none" stroke="var(--c-sea-soft)" stroke-linecap="round" stroke-width="2.5" opacity=".55">
          <path d="M104 318c7 0 7-4 14-4s7 4 14 4 7-4 14-4 7 4 14 4" />
          <path d="M226 330c7 0 7-4 14-4s7 4 14 4 7-4 14-4 7 4 14 4" />
          <path d="M150 348c7 0 7-4 14-4s7 4 14 4 7-4 14-4 7 4 14 4" />
        </g>
      </g>
      <rect x="40" y="386" width="340" height="74" fill="var(--c-surface-2)" />
      <path d="M80 380V206a130 130 0 0 1 260 0v174" fill="none" stroke="var(--c-bg)" stroke-width="6" />
      <rect x="54" y="370" width="312" height="18" rx="4" fill="var(--c-accent)" />
      <rect x="66" y="388" width="288" height="8" rx="3" fill="#000" opacity=".08" />

      <!-- plant -->
      <g>
        <path d="M113 336c-14-16-16-34-6-44 8 12 10 28 6 44Z" fill="var(--c-olive)" />
        <path d="M121 334c4-22 16-34 30-34-2 16-14 28-30 34Z" fill="var(--c-olive)" opacity=".8" />
        <path d="M117 336c-18-6-28-18-28-30 14 2 26 14 28 30Z" fill="var(--c-olive)" opacity=".65" />
        <path d="M99 370l5-34h30l5 34Z" fill="var(--c-sea)" />
        <rect x="96" y="332" width="46" height="8" rx="3" fill="var(--c-sea)" />
      </g>

      <!-- steaming pot -->
      <g fill="none" stroke="var(--c-sea)" stroke-linecap="round" stroke-width="3" opacity=".55">
        <path d="M212 292c-8-10 8-16 0-28s6-18 0-26" />
        <path d="M232 288c-8-10 8-16 0-28s6-18 0-26" />
        <path d="M252 292c-8-10 8-16 0-28" />
      </g>
      <path d="M186 370c-4-22-2-38 4-46h86c6 8 8 24 4 46Z" fill="#c4643c" />
      <path d="M190 332h86" stroke="#fff" stroke-opacity=".35" stroke-width="3" />
      <path d="M186 334c-12 0-14 12-4 12M280 334c12 0 14 12 4 12" fill="none" stroke="#8a3720" stroke-width="5" stroke-linecap="round" />
      <ellipse cx="233" cy="322" rx="48" ry="8" fill="#8a3720" />
      <rect x="226" y="306" width="14" height="10" rx="4" fill="#8a3720" />

      <!-- folded cloths -->
      <g>
        <rect x="294" y="352" width="58" height="18" rx="5" fill="var(--c-sea-soft)" />
        <rect x="298" y="336" width="50" height="17" rx="5" fill="#fff" />
        <path d="M306 336v17M340 336v17" stroke="var(--c-sea)" stroke-width="2" opacity=".5" />
        <path d="M300 352v18M346 352v18" stroke="var(--c-sea)" stroke-width="2" opacity=".35" />
      </g>
    </svg>
  )
}
{
  name === 'food' && (
    <svg class={className} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
      <rect x="20" y="20" width="320" height="260" rx="28" fill="var(--c-surface-2)" />
      <g opacity=".5" fill="var(--c-bg)">
        <circle cx="60" cy="60" r="5" /><circle cx="300" cy="60" r="5" /><circle cx="60" cy="240" r="5" /><circle cx="300" cy="240" r="5" />
      </g>
      <g fill="none" stroke="var(--c-sea)" stroke-linecap="round" stroke-width="3" opacity=".55">
        <path d="M150 116c-8-12 8-18 0-30s6-18 0-26" />
        <path d="M180 110c-8-12 8-18 0-30s6-18 0-26" />
        <path d="M210 116c-8-12 8-18 0-30" />
      </g>
      <ellipse cx="180" cy="214" rx="120" ry="22" fill="#000" opacity=".06" />
      <ellipse cx="180" cy="140" rx="104" ry="18" fill="#fff" />
      <path d="M76 140a104 70 0 0 0 208 0Z" fill="var(--c-accent)" />
      <path d="M92 160a92 52 0 0 0 176 0" fill="none" stroke="#fff" stroke-opacity=".3" stroke-width="3" />
      <path d="M108 174c20 4 40 6 72 6s52-2 72-6" fill="none" stroke="var(--c-sun)" stroke-width="5" stroke-dasharray="2 12" stroke-linecap="round" />
      <ellipse cx="180" cy="140" rx="92" ry="12" fill="#e9b36a" />
      <g fill="var(--c-olive)">
        <circle cx="150" cy="138" r="5" /><circle cx="196" cy="134" r="4" /><circle cx="220" cy="142" r="5" /><circle cx="170" cy="144" r="3.5" />
      </g>
      <rect x="164" y="206" width="32" height="10" rx="5" fill="var(--c-accent)" opacity=".85" />
      <path d="M262 92l46-30" stroke="var(--c-ink-muted)" stroke-width="6" stroke-linecap="round" />
      <ellipse cx="256" cy="98" rx="14" ry="9" transform="rotate(-33 256 98)" fill="var(--c-ink-muted)" />
    </svg>
  )
}
{
  name === 'home' && (
    <svg class={className} viewBox="0 0 360 300" aria-hidden="true" focusable="false">
      <rect x="20" y="20" width="320" height="260" rx="28" fill="var(--c-sea-soft)" />
      <circle cx="276" cy="78" r="26" fill="var(--c-sun)" />
      <path d="M86 262V128l94-58 94 58v134Z" fill="#fff" />
      <path d="M74 132l106-68 106 68" fill="none" stroke="var(--c-accent)" stroke-width="12" stroke-linejoin="round" stroke-linecap="round" />
      <path d="M152 262v-66a28 28 0 0 1 56 0v66Z" fill="var(--c-sea)" />
      <circle cx="196" cy="230" r="3.5" fill="var(--c-sun)" />
      <rect x="108" y="156" width="30" height="36" rx="15" fill="var(--c-sea)" opacity=".85" />
      <rect x="222" y="156" width="30" height="36" rx="15" fill="var(--c-sea)" opacity=".85" />
      <rect x="104" y="192" width="38" height="6" rx="3" fill="var(--c-accent)" />
      <rect x="218" y="192" width="38" height="6" rx="3" fill="var(--c-accent)" />
      <g fill="var(--c-olive)">
        <circle cx="114" cy="188" r="5" /><circle cx="124" cy="185" r="6" /><circle cx="134" cy="188" r="5" />
        <circle cx="228" cy="188" r="5" /><circle cx="238" cy="185" r="6" /><circle cx="248" cy="188" r="5" />
      </g>
      <rect x="40" y="258" width="280" height="8" rx="4" fill="var(--c-sea)" opacity=".25" />
      <g fill="var(--c-accent)">
        <path d="M60 92l4 10 10 4-10 4-4 10-4-10-10-4 10-4Z" />
        <path d="M300 172l3 7 7 3-7 3-3 7-3-7-7-3 7-3Z" opacity=".7" />
        <path d="M84 222l2.5 6 6 2.5-6 2.5-2.5 6-2.5-6-6-2.5 6-2.5Z" opacity=".55" />
      </g>
    </svg>
  )
}
