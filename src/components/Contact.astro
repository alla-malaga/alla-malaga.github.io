---
import { site, hasWhatsApp, hasEmail } from '../config/site';
import type { Dictionary } from '../i18n';
import WhatsAppButton from './WhatsAppButton.astro';
import EmailLink from './EmailLink.astro';

interface Props { t: Dictionary }
const { t } = Astro.props;
const subject = t.contact.emailSubject;
const text = hasWhatsApp || !hasEmail ? t.contact.text : t.contact.emailText;
---
<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="card">
      <h2 id="contact-title">{t.contact.title}</h2>
      <p>{text}</p>
      {hasWhatsApp && <WhatsAppButton t={t} variant="light" />}
      {
        hasEmail &&
          (hasWhatsApp ? (
            <p class="phone">
              {t.contact.emailLabel}: <EmailLink subject={subject} showAddress />
            </p>
          ) : (
            <>
              <EmailLink class="mail-btn" subject={subject}>
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m4 7 8 6 8-6" />
                </svg>
                <span>{t.contact.emailButton}</span>
              </EmailLink>
              <p class="phone"><EmailLink subject={subject} showAddress /></p>
            </>
          ))
      }
      {!hasWhatsApp && !hasEmail && <p class="pending">{t.contact.pending}</p>}
      {
        site.phoneDisplay && (
          <p class="phone">
            {t.contact.phoneLabel}:{' '}
            <a href={`tel:${site.phoneDisplay.replace(/[^\d+]/g, '')}`}>{site.phoneDisplay}</a>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--space-section);
  }
  .card {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: clamp(2rem, 1rem + 5vw, 4.5rem) var(--gutter);
    background: var(--c-accent);
    color: var(--c-on-accent);
    border-radius: var(--radius-lg);
    text-align: center;
    background-image: radial-gradient(circle at 100% 0, rgb(234 164 127 / 0.45) 0 7rem, transparent 7rem);
  }
  h2 {
    color: var(--c-on-accent);
  }
  p {
    max-width: 32rem;
    font-size: var(--step-1);
  }
  .pending {
    font-style: italic;
  }
  .phone {
    font-size: var(--step-0);
  }
  .phone :global(a) {
    color: var(--c-on-accent);
    overflow-wrap: anywhere;
  }
  .card :global(.mail-btn) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 3.25rem;
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    background: var(--c-on-accent);
    color: var(--c-accent);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }
  .card :global(.mail-btn:hover) {
    background: #fff;
    color: var(--c-accent-hover);
  }
</style>
